{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["jest"],
    "paths": {
      "@/*": ["./src/*"],
      "@/assets/*": ["./assets/*"],
      "@elemental/asset-schema": ["./packages/asset-schema/src/index.ts"],
      "@elemental/animation-core": ["./packages/animation-core/src/index.ts"],
      "@elemental/animation-runtime": ["./packages/animation-runtime/src/index.ts"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"],
  "exclude": ["node_modules", "dist", "web-build", "ios", "android", "coverage"]
}
